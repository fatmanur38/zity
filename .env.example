# Browser-visible defaults. These are UX defaults only; they are never a
# trusted assertion that a real network is available.
VITE_NETWORK_MODE=demo

# Vercel/server-only configuration. Do not prefix secrets with VITE_.
ZITY_NETWORK_MODE=demo
ZITY_ZCASH_NETWORK=testnet

# Which real-testnet implementation serves /api/testnet. Both prove payments
# on the real chain and neither falls back to a mock.
#   explorer  public testnet explorer; transparent receiver, no node to run.
#   gateway   your own Zebra + Zallet stack (see gateway/README.md).
ZITY_TESTNET_PROVIDER=explorer

# --- explorer provider ---
# Testnet transparent receiving address (tm… or t2…). A public explorer cannot
# read shielded outputs, so a z-address receiver is rejected at startup.
ZITY_TESTNET_RECEIVER_ADDRESS=
# Server-only secret, e.g. openssl rand -hex 32. Each challenge derives its
# unique payment amount from this, so it must never reach the browser.
ZITY_TESTNET_CHALLENGE_SECRET=
ZITY_TESTNET_EXPLORER_URL=https://api.testnet.cipherscan.app
ZITY_TESTNET_EXPLORER_TIMEOUT_MS=15000

# --- gateway provider ---
ZITY_TESTNET_GATEWAY_URL=https://gateway.example.test
ZITY_TESTNET_GATEWAY_TOKEN=

ZITY_TESTNET_PAYMENT_AMOUNT=0.001
ZITY_TESTNET_MIN_CONFIRMATIONS=1
ZITY_TESTNET_CHALLENGE_TTL_SECONDS=600
# confirmed is the safer default. detected unlocks before confirmation and the
# UI will continue to label the transaction as confirmation-pending.
ZITY_TESTNET_UNLOCK_POLICY=confirmed
ZITY_TESTNET_GATEWAY_TIMEOUT_MS=8000
