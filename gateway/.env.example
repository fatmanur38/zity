# Public gateway listener.
HOST=0.0.0.0
PORT=8787

# Generate a unique value, for example: openssl rand -hex 32
GATEWAY_BEARER_TOKEN=
ZITY_GATEWAY_NETWORK=testnet

# These must exactly match the Vercel/API deployment values.
ZITY_PAYMENT_AMOUNT=0.001
ZITY_MIN_CONFIRMATIONS=1
ZITY_CHALLENGE_TTL_SECONDS=600
ZITY_UNLOCK_POLICY=confirmed

# This reference ledger is deliberately bounded and in-memory.
ZITY_MAX_IN_MEMORY_CHALLENGES=1000
ZITY_EXPIRED_RETENTION_SECONDS=3600

# Current Zallet wallet JSON-RPC. Credentials remain gateway-side only.
ZALLET_RPC_URL=http://zallet:28232/
ZALLET_RPC_USER=
ZALLET_RPC_PASSWORD=
ZALLET_ACCOUNT_UUID=

# Current Zebra JSON-RPC, used independently to enforce chain === test.
# Mount Z3's z3-testnet-cookie volume read-only at /run/zebra-cookie.
ZEBRA_RPC_URL=http://zebra:18232/
ZEBRA_RPC_COOKIE_FILE=/run/zebra-cookie/.cookie
# Explicit credentials are an alternative; leave blank when using the cookie.
ZEBRA_RPC_USER=
ZEBRA_RPC_PASSWORD=

# Plain HTTP is appropriate only on a private, authenticated container/VPC network.
RPC_ALLOW_INSECURE_HTTP=true
RPC_TIMEOUT_MS=8000
ZALLET_TRANSACTION_PAGE_SIZE=100
ZALLET_TRANSACTION_MAX_PAGES=10

# Leave false until the exact receiver matching procedure in README.md passes
# against the pinned Zallet release. Repeat validation on every Zallet upgrade.
ZITY_LIVE_RECEIVER_MATCH_VALIDATED=false
